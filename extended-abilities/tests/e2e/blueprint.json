{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_ENVIRONMENT_TYPE": "local",
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": "/e2e-out/debug.log",
				"WP_DEBUG_DISPLAY": false,
				"AUTOMATIC_UPDATER_DISABLED": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/WordPress/mcp-adapter/releases/download/v0.7.1/mcp-adapter.zip"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "extended-abilities/extended-abilities.php"
		},
		{
			"step": "runPHP",
			"code": "<?php require '/e2e/setup.php';"
		}
	]
}
